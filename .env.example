# --- Server ---
NODE_ENV=development

# --- Cinestudio defaults ---
# Where SQLite stores runs, configs, artefacts
CINESTUDIO_DATA_DIR=./data
CINESTUDIO_ARTIFACT_DIR=./artifacts

# --- Provider keys ---
# Fill these from the onboarding screen. Server reads them if no DB config exists.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# MiniMax endpoint + key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

OLLAMA_BASE_URL=http://localhost:11434

# --- Default provider & model ---
# When users finish onboarding, the dashboard overrides these
CINESTUDIO_DEFAULT_PROVIDER=bedrock
CINESTUDIO_DEFAULT_MODEL=global.anthropic.claude-sonnet-4-6

# --- Render providers (Veo/Sora/Runway) ---
VEO_MODEL=veo-3.1
VEO_PROJECT_ID=

RUNWAY_API_KEY=
SORA_API_KEY=
