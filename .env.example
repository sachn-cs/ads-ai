# --- Server ---
NODE_ENV=production

# --- Cinestudio defaults ---
# Where SQLite stores runs, configs, artefacts
CINESTUDIO_DATA_DIR=./data
CINESTUDIO_ARTIFACT_DIR=./artifacts

# --- Auth (single-user) ---
# Generate with: openssl rand -hex 32
# When unset, the app runs unauthenticated (dev mode only).
CINESTUDIO_AUTH_TOKEN=
# Used for encryption-at-rest of API keys (AES-256-GCM via scrypt).
# Generate with: openssl rand -hex 32
CINESTUDIO_SECRET=
# Session secret (defaults to CINESTUDIO_SECRET if unset).
CINESTUDIO_SESSION_SECRET=

# --- Logging ---
LOG_LEVEL=info
TZ=UTC

# --- Provider keys ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

OLLAMA_BASE_URL=http://localhost:11434

# --- Default provider & model ---
CINESTUDIO_DEFAULT_PROVIDER=minimax
CINESTUDIO_DEFAULT_MODEL=MiniMax-M3

# --- Render providers ---
VEO_MODEL=veo-3.1
VEO_PROJECT_ID=

RUNWAY_API_KEY=
SORA_API_KEY=
